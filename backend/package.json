{
  "name": "madrilusa-backend",
  "version": "1.0.0",
  "description": "Backend modular para plataforma Madrilusa",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts",
    "db:migrate": "prisma migrate dev",
    "setup:admin": "npm run db:push && npm run db:seed"
  },
  "dependencies": {
    "@prisma/client": "^5.8.1",
    "@types/multer": "^2.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "multer": "^2.0.2",
    "prisma": "^5.8.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.6",
    "concurrently": "^9.2.0",
    "tsx": "^4.6.2",
    "typescript": "^5.3.3"
  },
  "keywords": [
    "madrilusa",
    "backend",
    "api",
    "express",
    "prisma"
  ],
  "author": "Projeto Madrilusa",
  "license": "MIT"
}

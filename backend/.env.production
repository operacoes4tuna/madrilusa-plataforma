# Database Configuration
DATABASE_URL="file:./data/prod.db"

# OpenAI API Key (para sistemas de IA)
OPENAI_API_KEY="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"

# Server Configuration
PORT=3001
NODE_ENV=production

# CORS Origins - substituir pelos domínios reais
CORS_ORIGINS="https://madrilusa.com,https://www.madrilusa.com"

# Security Settings
JWT_SECRET="madrilusa-jwt-secret-production-2025"
BCRYPT_ROUNDS=12

# Rate Limiting (requests per time window)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# IA Rate Limiting
AI_RATE_LIMIT_WINDOW_MS=900000
AI_RATE_LIMIT_MAX_REQUESTS=20
SINERGIA_RATE_LIMIT_WINDOW_MS=300000
SINERGIA_RATE_LIMIT_MAX_REQUESTS=10

# Logging
LOG_LEVEL=info
LOG_FILE_PATH=./logs/madrilusa-backend.log

# Database Backup
BACKUP_ENABLED=true
BACKUP_INTERVAL_HOURS=6
BACKUP_RETENTION_DAYS=30

# Health Check
HEALTH_CHECK_ENABLED=true
HEALTH_CHECK_PATH=/health
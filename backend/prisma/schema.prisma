// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  nomeCompleto String
  email        String   @unique
  senha        String   // Hash será implementado futuramente
  telemovel    String?  // Telemóvel do usuário (opcional)
  foto         String?  // URL da foto do usuário (opcional)
  categoria    String?  // ✨ NOVO: categoria do usuário (IMIGRANTE, EMPRESA, MUNICIPIO, ACADEMIA, FAMILIA_ACOLHIMENTO)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  
  // ✨ NOVO: Relação com perfil específico de imigrante
  perfilImigrante PerfilImigrante?
  
  // ✨ FASE 2: Relação com perfil específico de empresa
  perfilEmpresa PerfilEmpresa?
  
  // ✨ FASE 3: Relação com perfil específico de município
  perfilMunicipio PerfilMunicipio?
  
  // ✨ FASE 4: Relação com perfil específico de academia
  perfilAcademia PerfilAcademia?
  
  // 🔮 FUTURAS FASES: Relações com outros perfis específicos
  // perfilFamilia PerfilFamilia?
  
  @@map("users")
}

// ✨ NOVO: Perfil específico de Imigrante (FASE 1)
model PerfilImigrante {
  id                    String   @id @default(cuid())
  userId                String   @unique
  nacionalidade         String
  dataNascimento        DateTime
  objetivos             String?  // JSON array dos objetivos selecionados (Emprego, Formação, Regularização)
  objetivoOutros        String?  // Descrição de outros objetivos (texto livre)
  mensagem              String?  // Campo opcional adicional
  aceitaNotificacoes    Boolean  @default(false) // Aceita receber notificações de oportunidades
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  
  // Relação com User (1:1 com cascade delete)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@map("perfis_imigrante")
}

// ✨ FASE 2: Perfil específico de Empresa
model PerfilEmpresa {
  id                String   @id @default(cuid())
  userId            String   @unique
  nomeEmpresa       String   // ✨ Obrigatório: Nome da empresa
  pessoaContacto    String?  // ✨ Opcional: Nome do responsável
  morada            String?  // ✨ Opcional: Endereço da empresa
  observacoes       String?  // ✨ Opcional: Vagas, requisitos, detalhes
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  
  // Relação com User (1:1 com cascade delete)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@map("perfis_empresa")
}

// ✨ FASE 3: Perfil específico de Município
model PerfilMunicipio {
  id                    String   @id @default(cuid())
  userId                String   @unique
  nomeMunicipio         String?  // ✨ Opcional: Nome do município
  distrito              String?  // ✨ Opcional: Distrito/Região administrativa
  pessoaContacto        String?  // ✨ Opcional: Pessoa de contacto institucional
  funcaoCargo           String?  // ✨ Opcional: Função/Cargo do responsável
  projetosApoio         String?  // ✨ Opcional: Projetos de apoio existentes (CLAIM, CLDS, etc.)
  disponibilidadeAcoes  String?  // ✨ Opcional: Disponibilidade para acolher ações locais
  observacoes           String?  // ✨ Opcional: Horários, espaços, eventos locais
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  
  // Relação com User (1:1 com cascade delete)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@map("perfis_municipio")
}

// ✨ FASE 4: Perfil específico de Academia
model PerfilAcademia {
  id                String   @id @default(cuid())
  userId            String   @unique
  nomeAcademia      String   // ✨ Obrigatório: Nome da Academia/Instituição
  tipoAcademia      String?  // ✨ Opcional: Tipo (escola, universidade, centro, etc.)
  regiao            String?  // ✨ Opcional: Região/Zona de atuação
  pessoaContacto    String?  // ✨ Opcional: Nome do responsável
  emailInstitucional String? // ✨ Opcional: Email institucional
  telefone          String?  // ✨ Opcional: Telefone de contacto
  ofertaFormativa   String?  // ✨ Opcional: Descrição dos cursos oferecidos
  website           String?  // ✨ Opcional: URL do site oficial
  observacoes       String?  // ✨ Opcional: Informações adicionais
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  
  // Relação com User (1:1 com cascade delete)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@map("perfis_academia")
} 